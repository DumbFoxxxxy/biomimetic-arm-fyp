Dim swApp As Object

Sub main()
    On Error GoTo ErrorHandler
    Set swApp = Application.SldWorks
    swApp.Visible = True
    WriteLog "start"

    Dim base As String
    base = "D:\XJTLU\PSP\" & ChrW(&H9AA8) & ChrW(&H9ABC)
    Dim outDir As String
    outDir = base & "\" & ChrW(&H5B9E) & ChrW(&H4F53) & ChrW(&H6A21) & ChrW(&H578B)
    EnsureDir outDir

    ' swImportStlVrmlModelType = 208 -> 2 = solid body
    ' swImportStlVrmlUnits     = 210 -> 0 = mm
    swApp.SetUserPreferenceIntegerValue 208, 2
    swApp.SetUserPreferenceIntegerValue 210, 0

    ImportOne base, outDir, "radius", ChrW(&H6861) & ChrW(&H9AA8)
    ImportOne base, outDir, "ulna", ChrW(&H5C3A) & ChrW(&H9AA8)
    ImportOne base, outDir, "humerus", ChrW(&H80B1) & ChrW(&H9AA8)
    ImportOne base, outDir, "scapula", ChrW(&H80A9) & ChrW(&H80DB) & ChrW(&H9AA8)

    WriteLog "done"
    swApp.ExitApp
    Exit Sub

ErrorHandler:
    WriteLog "ERROR " & Err.Number & " " & Err.Description
    swApp.ExitApp
End Sub

Sub ImportOne(base As String, outDir As String, asciiName As String, cnName As String)
    Dim src As String
    src = base & "\_optimize\reduced\" & asciiName & ".stl"
    Dim errs As Long
    Dim doc As Object
    Set doc = swApp.LoadFile4(src, "r", Nothing, errs)
    If doc Is Nothing Then
        WriteLog "FAILED load " & asciiName & " err=" & errs
        Exit Sub
    End If

    Dim nSolid As Long
    nSolid = CountArr(doc.GetBodies2(0, False))
    Dim faces As Long
    faces = 0
    Dim bodies As Variant
    bodies = doc.GetBodies2(0, False)
    If Not IsEmpty(bodies) Then
        Dim bd As Object
        Set bd = bodies(0)
        faces = bd.GetFaceCount()
    End If

    Dim box As Variant
    box = doc.GetPartBox(True)
    Dim boxTxt As String
    boxTxt = ""
    If Not IsEmpty(box) Then
        boxTxt = " box=" & Format(box(0), "0.0") & "," & Format(box(1), "0.0") & "," & Format(box(2), "0.0") _
               & ".." & Format(box(3), "0.0") & "," & Format(box(4), "0.0") & "," & Format(box(5), "0.0")
    End If

    Dim out As String
    out = outDir & "\" & cnName & ".SLDPRT"
    Dim ok As Boolean
    ok = doc.SaveAs3(out, 0, 1)
    WriteLog asciiName & " solid=" & nSolid & " faces=" & faces & " saved=" & ok & boxTxt
    swApp.CloseDoc doc.GetTitle()
End Sub

Function CountArr(a As Variant) As Long
    If IsEmpty(a) Then
        CountArr = 0
    Else
        CountArr = UBound(a) + 1
    End If
End Function

Sub EnsureDir(path As String)
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    If Not fso.FolderExists(path) Then
        fso.CreateFolder path
    End If
End Sub

Sub WriteLog(msg As String)
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    Dim ts As Object
    Set ts = fso.OpenTextFile("D:\XJTLU\PSP\" & ChrW(&H9AA8) & ChrW(&H9ABC) & "\_optimize\MakeSolids.log", 8, True)
    ts.WriteLine Now & " " & msg
    ts.Close
End Sub
