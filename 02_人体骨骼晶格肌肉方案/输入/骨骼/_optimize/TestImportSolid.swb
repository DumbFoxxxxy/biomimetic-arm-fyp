Dim swApp As Object

Sub main()
    On Error GoTo ErrorHandler
    Set swApp = Application.SldWorks
    swApp.Visible = True
    WriteLog "start"

    Dim stl As String
    stl = "D:\XJTLU\PSP\" & ChrW(&H9AA8) & ChrW(&H9ABC) & "\_optimize\welded\radius.stl"
    WriteLog "exists=" & CreateObject("Scripting.FileSystemObject").FileExists(stl)

    TryMode 0, "graphics", stl
    TryMode 1, "surface", stl
    TryMode 2, "solid", stl

    swApp.ExitApp
    Exit Sub

ErrorHandler:
    WriteLog "ERROR " & Err.Number & " " & Err.Description
    swApp.ExitApp
End Sub

Sub TryMode(mode As Long, label As String, stl As String)
    ' swImportStlVrmlModelType = 208 ;  swImportStlVrmlUnits = 210 (0 = mm)
    swApp.SetUserPreferenceIntegerValue 208, mode
    swApp.SetUserPreferenceIntegerValue 210, 0

    Dim errs As Long
    Dim warns As Long
    Dim doc As Object
    Set doc = swApp.OpenDoc6(stl, 1, 0, "", errs, warns)
    If doc Is Nothing Then
        WriteLog "[" & label & "] open FAILED err=" & errs
        Exit Sub
    End If
    WriteLog "[" & label & "] opened; errs=" & errs
    ReportBodies doc, 0, "solid"
    ReportBodies doc, 1, "sheet"
    ReportBodies doc, 4, "general"
    swApp.CloseDoc doc.GetTitle()
End Sub

Sub ReportBodies(doc As Object, btype As Long, label As String)
    Dim bodies As Variant
    bodies = doc.GetBodies2(btype, False)
    If IsEmpty(bodies) Then
        WriteLog "    " & label & " = 0"
    Else
        Dim i As Integer
        For i = 0 To UBound(bodies)
            Dim bd As Object
            Set bd = bodies(i)
            WriteLog "    " & label & " = " & (UBound(bodies) + 1) & " ; body" & i & " faces=" & bd.GetFaceCount()
        Next i
    End If
End Sub

Sub WriteLog(msg As String)
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    Dim ts As Object
    Set ts = fso.OpenTextFile("D:\XJTLU\PSP\" & ChrW(&H9AA8) & ChrW(&H9ABC) & "\_optimize\TestImportSolid.log", 8, True)
    ts.WriteLine Now & " " & msg
    ts.Close
End Sub
