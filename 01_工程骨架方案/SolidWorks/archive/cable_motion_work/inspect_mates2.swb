Dim swApp As Object
Dim reportPath As String

Sub main()
    Dim root As String
    Dim asmPath As String
    Dim errs As Long
    Dim warns As Long
    Dim asm As Object
    Dim mates As Variant
    Dim i As Long
    Dim mt As Object
    Dim me As Object
    Dim comp As Object
    Dim ec As Long
    Dim j As Long

    Set swApp = Application.SldWorks
    swApp.Visible = True
    root = "D:\XJTLU\PSP\final_model\cable_motion_work"
    reportPath = root & "\audit\mates2.txt"
    ResetFile reportPath
    asmPath = FindFile(root, ".SLDASM")
    Set asm = swApp.OpenDoc6(asmPath, 2, 1, "", errs, warns)
    If asm Is Nothing Then
        WriteLine reportPath, "ERROR|open|" & errs & "|" & warns
        swApp.ExitApp
        Exit Sub
    End If

    mates = asm.GetMates()
    If IsEmpty(mates) Then
        WriteLine reportPath, "ERROR|no_mates"
    Else
        For i = LBound(mates) To UBound(mates)
            Set mt = mates(i)
            WriteLine reportPath, "mate|" & i & "|" & SafeStr(mt.Name) & "|" & SafeStr(mt.Type)
            ec = 0
            On Error Resume Next
            ec = mt.GetMateEntityCount()
            On Error GoTo 0
            WriteLine reportPath, "count|" & i & "|" & CStr(ec)
            For j = 0 To ec - 1
                Set me = Nothing
                On Error Resume Next
                Set me = mt.MateEntity(j)
                On Error GoTo 0
                If Not me Is Nothing Then
                    Set comp = Nothing
                    On Error Resume Next
                    Set comp = me.ReferenceComponent
                    On Error GoTo 0
                    WriteLine reportPath, "entity|" & i & "|" & j & "|" & _
                        SafeStr(comp.Name2) & "|" & SafeStr(me.EntityType)
                End If
            Next j
        Next i
    End If

    swApp.CloseDoc asm.GetTitle()
    swApp.ExitApp
End Sub

Sub ResetFile(path As String)
    Dim fso As Object
    Dim ts As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set ts = fso.CreateTextFile(path, True)
    ts.Close
End Sub

Sub WriteLine(path As String, text As String)
    Dim fso As Object
    Dim ts As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set ts = fso.OpenTextFile(path, 8, True)
    ts.WriteLine text
    ts.Close
End Sub

Function SafeStr(v As Variant) As String
    On Error Resume Next
    SafeStr = CStr(v)
    On Error GoTo 0
End Function

Function FindFile(folder As String, ext As String) As String
    Dim fso As Object
    Dim fl As Object
    Dim file As Object
    Dim result As String
    result = ""
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set fl = fso.GetFolder(folder)
    For Each file In fl.Files
        If UCase(Right(file.Name, Len(ext))) = UCase(ext) Then
            result = file.Path
            Exit For
        End If
    Next file
    FindFile = result
End Function
