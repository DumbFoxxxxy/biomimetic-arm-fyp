Dim swApp As Object
Dim reportPath As String
Dim mateCount As Long

Sub main()
    Dim root As String
    Dim asmPath As String
    Dim errs As Long
    Dim warns As Long
    Dim asm As Object
    Dim fso As Object
    Dim outDir As String

    Set swApp = Application.SldWorks
    swApp.Visible = True
    root = "D:\XJTLU\PSP\final_model\cable_motion_work"
    outDir = root & "\audit"
    EnsureFolder outDir
    reportPath = outDir & "\mates.txt"
    ResetFile reportPath

    asmPath = FindFile(root, ".SLDASM")
    Set asm = swApp.OpenDoc6(asmPath, 2, 1, "", errs, warns)
    If asm Is Nothing Then
        WriteLine reportPath, "ERROR|open|" & errs & "|" & warns
        swApp.ExitApp
        Exit Sub
    End If

    Dim f As Object
    mateCount = 0
    Set f = asm.FirstFeature()
    Do While Not f Is Nothing
        WalkFeature f
        Set f = f.GetNextFeature()
    Loop

    WriteLine reportPath, "mate_count|" & mateCount
    asm.EditRebuild3
    WriteLine reportPath, "rebuild|" & asm.GetTitle()
    swApp.CloseDoc asm.GetTitle()
    swApp.ExitApp
End Sub

Sub WalkFeature(f As Object)
    Dim tn As String
    Dim sf As Object
    Dim mt As Object
    Dim ec As Long
    Dim ei As Long
    Dim me As Object
    Dim comp As Object
    Dim cname As String
    Dim line As String
    tn = SafeStr(f.GetTypeName2())
    WriteLine reportPath, "feature|" & SafeStr(f.Name) & "|" & tn
    If InStr(1, tn, "Mate", vbTextCompare) > 0 Then
        mateCount = mateCount + 1
        WriteLine reportPath, "mate|" & SafeStr(f.Name) & "|" & tn
        Set mt = Nothing
        On Error Resume Next
        Set mt = f.GetSpecificFeature2()
        If Not mt Is Nothing Then
            line = "mate_detail|" & SafeStr(f.Name) & "|type=" & SafeStr(mt.Type)
            line = line & "|align=" & SafeStr(mt.Alignment)
            ec = mt.GetMateEntityCount()
            line = line & "|entities=" & CStr(ec)
            WriteLine reportPath, line
            For ei = 0 To ec - 1
                Set me = Nothing
                Set comp = Nothing
                cname = ""
                Set me = mt.MateEntity(ei)
                If Not me Is Nothing Then
                    Set comp = me.ReferenceComponent
                    If Not comp Is Nothing Then cname = SafeStr(comp.Name2)
                    WriteLine reportPath, "mate_entity|" & SafeStr(f.Name) & "|" & _
                        CStr(ei) & "|" & cname & "|" & SafeStr(me.EntityType)
                End If
            Next ei
        End If
        On Error GoTo 0
    End If
    On Error Resume Next
    Set sf = f.GetFirstSubFeature()
    Do While Not sf Is Nothing
        WalkFeature sf
        Set sf = sf.GetNextSubFeature()
    Loop
    On Error GoTo 0
End Sub

Sub EnsureFolder(path As String)
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    If Not fso.FolderExists(path) Then fso.CreateFolder path
End Sub

Sub ResetFile(path As String)
    Dim fso As Object
    Dim ts As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set ts = fso.CreateTextFile(path, True)
    ts.Close
End Sub

Sub WriteLine(path As String, text As String)
    Dim fso As Object
    Dim ts As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set ts = fso.OpenTextFile(path, 8, True)
    ts.WriteLine text
    ts.Close
End Sub

Function SafeStr(v As Variant) As String
    On Error Resume Next
    SafeStr = CStr(v)
    On Error GoTo 0
End Function

Function FindFile(folder As String, ext As String) As String
    Dim fso As Object
    Dim fl As Object
    Dim file As Object
    Dim result As String
    result = ""
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set fl = fso.GetFolder(folder)
    For Each file In fl.Files
        If UCase(Right(file.Name, Len(ext))) = UCase(ext) Then
            result = file.Path
            Exit For
        End If
    Next file
    FindFile = result
End Function
