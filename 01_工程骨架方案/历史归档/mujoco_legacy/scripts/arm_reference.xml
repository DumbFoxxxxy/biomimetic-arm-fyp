<mujoco model="right_arm_reference_skeleton">
  <compiler
    angle="degree"
    coordinate="local"
    autolimits="true"
    meshdir="assets"
  />

  <!-- The first pass is a kinematic model. Turn gravity on after the joint
       centers, axes and ranges have been validated. -->
  <option timestep="0.002" gravity="0 0 0" integrator="implicitfast"/>

  <visual>
    <headlight diffuse="0.8 0.8 0.8" ambient="0.25 0.25 0.25"/>
    <rgba haze="0.15 0.2 0.25 1"/>
    <global azimuth="135" elevation="-18"/>
  </visual>

  <default>
    <default class="visual_mesh">
      <geom
        type="mesh"
        contype="0"
        conaffinity="0"
        group="1"
        rgba="0.82 0.80 0.72 1"
      />
    </default>
    <default class="arm_joint">
      <joint
        type="hinge"
        limited="true"
        damping="0.25"
        armature="0.02"
      />
    </default>
    <default class="position_actuator">
      <position kp="35" kv="2.5"/>
    </default>
  </default>

  <asset>
    <mesh name="clavicle" file="clavicle.obj" scale="0.001 0.001 0.001"/>
    <mesh name="scapula" file="scapula.obj" scale="0.001 0.001 0.001"/>
    <mesh name="humerus" file="humerus.obj" scale="0.001 0.001 0.001"/>
    <mesh name="radius" file="radius.obj" scale="0.001 0.001 0.001"/>
    <mesh name="ulna" file="ulna.obj" scale="0.001 0.001 0.001"/>

    <material name="clavicle_mat" rgba="0.78 0.76 0.68 1"/>
    <material name="scapula_mat" rgba="0.72 0.75 0.69 1"/>
    <material name="humerus_mat" rgba="0.82 0.80 0.72 1"/>
    <material name="radius_mat" rgba="0.76 0.73 0.66 1"/>
    <material name="ulna_mat" rgba="0.70 0.72 0.67 1"/>
    <material name="torso_mat" rgba="0.48 0.52 0.55 1"/>
    <material name="rib_mat" rgba="0.68 0.70 0.65 1"/>
    <material name="joint_mat" rgba="0.95 0.35 0.10 1"/>
  </asset>

  <worldbody>
    <light
      name="key_light"
      pos="-0.35 -0.45 1.80"
      dir="0.35 0.25 -1"
      directional="true"
      diffuse="0.9 0.9 0.9"
      specular="0.2 0.2 0.2"
    />
    <geom
      name="floor"
      type="plane"
      size="2 2 0.1"
      pos="0 0 0"
      material="torso_mat"
      contype="0"
      conaffinity="0"
      group="0"
    />

    <!-- BodyParts3D skeleton coordinates are in millimetres. The mesh scale
         converts them to metres. Each body origin is an anatomical joint
         centre, and the mesh is shifted back by that pivot. -->
    <body name="torso" pos="0 0 0">
      <geom
        name="torso_visual"
        type="capsule"
        fromto="-0.04 -0.10 1.34 -0.04 -0.10 1.15"
        size="0.035"
        material="torso_mat"
        contype="0"
        conaffinity="0"
      />
      <!-- Simplified thorax reference for scapulothoracic motion. These
           capsules are attachment references, not anatomical collision
           geometry. Replace them with the rib model exported from CAD. -->
      <geom name="sternum" type="capsule" fromto="-0.055 -0.145 1.17 -0.035 -0.145 1.36" size="0.012" material="rib_mat" contype="0" conaffinity="0"/>
      <geom name="thoracic_spine" type="capsule" fromto="-0.035 0.050 1.12 -0.035 0.050 1.43" size="0.018" material="rib_mat" contype="0" conaffinity="0"/>
      <geom name="rib_1_r" type="capsule" fromto="-0.035 -0.120 1.370 -0.115 -0.020 1.335" size="0.007" material="rib_mat" contype="0" conaffinity="0"/>
      <geom name="rib_2_r" type="capsule" fromto="-0.035 -0.125 1.335 -0.125 -0.005 1.285" size="0.007" material="rib_mat" contype="0" conaffinity="0"/>
      <geom name="rib_3_r" type="capsule" fromto="-0.035 -0.130 1.300 -0.132 0.000 1.235" size="0.007" material="rib_mat" contype="0" conaffinity="0"/>
      <geom name="rib_4_r" type="capsule" fromto="-0.035 -0.130 1.260 -0.128 0.010 1.190" size="0.007" material="rib_mat" contype="0" conaffinity="0"/>
      <geom name="rib_5_r" type="capsule" fromto="-0.035 -0.125 1.215 -0.118 0.020 1.145" size="0.007" material="rib_mat" contype="0" conaffinity="0"/>
      <geom name="rib_6_r" type="capsule" fromto="-0.035 -0.115 1.175 -0.100 0.025 1.105" size="0.007" material="rib_mat" contype="0" conaffinity="0"/>
      <geom name="rib_1_l" type="capsule" fromto="-0.055 -0.120 1.370 -0.015 -0.020 1.335" size="0.007" material="rib_mat" contype="0" conaffinity="0"/>
      <geom name="rib_2_l" type="capsule" fromto="-0.055 -0.125 1.335 -0.010 -0.005 1.285" size="0.007" material="rib_mat" contype="0" conaffinity="0"/>
      <geom name="rib_3_l" type="capsule" fromto="-0.055 -0.130 1.300 -0.005 0.000 1.235" size="0.007" material="rib_mat" contype="0" conaffinity="0"/>
      <geom name="rib_4_l" type="capsule" fromto="-0.055 -0.130 1.260 -0.005 0.010 1.190" size="0.007" material="rib_mat" contype="0" conaffinity="0"/>
      <geom name="rib_5_l" type="capsule" fromto="-0.055 -0.125 1.215 -0.010 0.020 1.145" size="0.007" material="rib_mat" contype="0" conaffinity="0"/>
      <geom name="rib_6_l" type="capsule" fromto="-0.055 -0.115 1.175 -0.020 0.025 1.105" size="0.007" material="rib_mat" contype="0" conaffinity="0"/>
      <site name="sternoclavicular_ref" pos="-0.01142 -0.12958 1.31903" size="0.008" material="joint_mat"/>

      <!-- Sternoclavicular joint: elevation/depression, protraction/
           retraction and axial rotation. -->
      <body name="clavicle_protraction" pos="-0.01142 -0.12958 1.31903">
        <joint
          name="clavicle_protraction"
          class="arm_joint"
          axis="0 0 1"
          range="-30 40"
        />
        <inertial pos="0 0 0" mass="0.01" diaginertia="1e-5 1e-5 1e-5"/>

        <body name="clavicle_elevation" pos="0 0 0">
          <joint
            name="clavicle_elevation"
            class="arm_joint"
            axis="0 1 0"
            range="-20 40"
          />
          <inertial pos="0 0 0" mass="0.01" diaginertia="1e-5 1e-5 1e-5"/>

          <body name="clavicle_axial_rotation" pos="0 0 0">
            <joint
              name="clavicle_axial_rotation"
              class="arm_joint"
              axis="1 0 0"
              range="-30 30"
            />
            <inertial pos="0 0 0" mass="0.01" diaginertia="1e-5 1e-5 1e-5"/>
            <geom
              name="clavicle_visual"
              class="visual_mesh"
              mesh="clavicle"
              material="clavicle_mat"
              pos="-0.01142 -0.12958 1.31903"
              mass="0.15"
            />

            <!-- Acromioclavicular/scapulothoracic joint: upward rotation,
                 posterior tilt and external rotation. -->
            <body name="scapula_upward_rotation" pos="-0.13804 0.05895 0.03056">
              <joint
                name="scapula_upward_rotation"
                class="arm_joint"
                axis="0 1 0"
                range="-20 50"
              />
              <inertial pos="0 0 0" mass="0.01" diaginertia="1e-5 1e-5 1e-5"/>

              <body name="scapula_posterior_tilt" pos="0 0 0">
                <joint
                  name="scapula_posterior_tilt"
                  class="arm_joint"
                  axis="1 0 0"
                  range="-15 35"
                />
                <inertial pos="0 0 0" mass="0.01" diaginertia="1e-5 1e-5 1e-5"/>

                <body name="scapula_external_rotation" pos="0 0 0">
                  <joint
                    name="scapula_external_rotation"
                    class="arm_joint"
                    axis="0 0 1"
                    range="-20 30"
                  />
                  <inertial pos="0 0 0" mass="0.01" diaginertia="1e-5 1e-5 1e-5"/>
          <site name="acromioclavicular_ref" pos="0 0 0" size="0.008" material="joint_mat"/>
          <geom
            name="scapula_visual"
            class="visual_mesh"
            mesh="scapula"
            material="scapula_mat"
            pos="0.14946 0.07063 -1.34959"
            mass="0.15"
            />

          <!-- Glenohumeral joint. Three serial hinges expose the three
               shoulder rotations as independent controls. Axes are relative
               to the scapula frame and should be replaced with joint axes
               measured from the real assembly. -->
          <body name="shoulder_rotation" pos="-0.01741 -0.00596 -0.01708">
            <joint
              name="shoulder_rotation"
              class="arm_joint"
              axis="0 0 1"
              range="-90 90"
            />
            <inertial pos="0 0 0" mass="0.01" diaginertia="1e-5 1e-5 1e-5"/>

            <body name="shoulder_flexion" pos="0 0 0">
              <joint
                name="shoulder_flexion"
                class="arm_joint"
                axis="1 0 0"
                range="-45 180"
              />
              <inertial pos="0 0 0" mass="0.01" diaginertia="1e-5 1e-5 1e-5"/>

              <body name="shoulder_abduction" pos="0 0 0">
                <joint
                  name="shoulder_abduction"
                  class="arm_joint"
                  axis="0 1 0"
                  range="-45 180"
                />
                <inertial pos="0 0 0" mass="0.01" diaginertia="1e-5 1e-5 1e-5"/>
                <geom
                  name="humerus_visual"
                  class="visual_mesh"
                  mesh="humerus"
                  material="humerus_mat"
                  pos="0.16687 0.07659 -1.33251"
                  mass="1.8"
                />
                <site name="elbow_ref" pos="-0.04725 0.00781 -0.29301" size="0.008" material="joint_mat"/>

                <!-- The ulna is the forearm reference bone. During
                     pronation/supination it remains nearly fixed while
                     the radius swings around its longitudinal axis. -->
                <body name="forearm_ulna" pos="-0.04725 0.00781 -0.29301">
                  <joint
                    name="elbow_flexion"
                    class="arm_joint"
                    axis="1 0 0"
                    range="0 145"
                  />
                  <inertial pos="0 0 0" mass="0.01" diaginertia="1e-5 1e-5 1e-5"/>
                  <geom
                    name="ulna_visual"
                    class="visual_mesh"
                    mesh="ulna"
                    material="ulna_mat"
                    pos="0.21412 0.06878 -1.03950"
                    mass="0.45"
                  />
                  <site name="wrist_ref" pos="-0.04136 -0.04582 -0.23290" size="0.008" material="joint_mat"/>
                  <site
                    name="radiocapitellar_contact_ref"
                    pos="-0.01956 -0.00251 -0.00328"
                    size="0.006"
                    rgba="0.10 0.35 0.95 1"
                  />
                  <site
                    name="distal_ulnar_head_ref"
                    pos="-0.02251 -0.04355 -0.23300"
                    size="0.006"
                    rgba="0.10 0.35 0.95 1"
                  />
                  <!-- Diagnostic line for the pronation/supination axis. -->
                  <geom
                    name="pronation_axis_visual"
                    type="capsule"
                    fromto="-0.01956 -0.00251 -0.00328 -0.02251 -0.04355 -0.23300"
                    size="0.0015"
                    rgba="0.05 0.35 0.95 0.85"
                    contype="0"
                    conaffinity="0"
                    group="2"
                  />

                  <!-- The pronation axis starts at the proximal
                       radiocapitellar contact point and ends at the centre
                       of the distal ulnar head. The contact point is the
                       body pivot, so it remains fixed while the curved
                       radius swings at its distal end. -->
                  <body name="radius" pos="-0.01956 -0.00251 -0.00328">
                    <joint
                      name="forearm_pronation"
                      class="arm_joint"
                      axis="-0.01262 -0.17584 -0.98434"
                      range="-90 90"
                    />
                    <inertial pos="0 0 0" mass="0.01" diaginertia="1e-5 1e-5 1e-5"/>
                    <geom
                      name="radius_visual"
                      class="visual_mesh"
                      mesh="radius"
                      material="radius_mat"
                      pos="0.23368 0.07129 -1.03622"
                      mass="0.35"
                    />
                  </body>
                </body>
              </body>
            </body>
          </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <camera
      name="arm_view"
      mode="targetbodycom"
      target="forearm_ulna"
      pos="-0.12 -0.55 1.28"
      xyaxes="1 0 0 0 0.716 0.698"
    />
  </worldbody>

  <actuator>
    <position
      name="clavicle_protraction_act"
      class="position_actuator"
      joint="clavicle_protraction"
      ctrlrange="-30 40"
    />
    <position
      name="clavicle_elevation_act"
      class="position_actuator"
      joint="clavicle_elevation"
      ctrlrange="-20 40"
    />
    <position
      name="clavicle_axial_rotation_act"
      class="position_actuator"
      joint="clavicle_axial_rotation"
      ctrlrange="-30 30"
    />
    <position
      name="scapula_upward_rotation_act"
      class="position_actuator"
      joint="scapula_upward_rotation"
      ctrlrange="-20 50"
    />
    <position
      name="scapula_posterior_tilt_act"
      class="position_actuator"
      joint="scapula_posterior_tilt"
      ctrlrange="-15 35"
    />
    <position
      name="scapula_external_rotation_act"
      class="position_actuator"
      joint="scapula_external_rotation"
      ctrlrange="-20 30"
    />
    <position
      name="shoulder_rotation_act"
      class="position_actuator"
      joint="shoulder_rotation"
      ctrlrange="-90 90"
    />
    <position
      name="shoulder_flexion_act"
      class="position_actuator"
      joint="shoulder_flexion"
      ctrlrange="-45 180"
    />
    <position
      name="shoulder_abduction_act"
      class="position_actuator"
      joint="shoulder_abduction"
      ctrlrange="-45 180"
    />
    <position
      name="elbow_flexion_act"
      class="position_actuator"
      joint="elbow_flexion"
      ctrlrange="0 145"
    />
    <position
      name="forearm_pronation_act"
      class="position_actuator"
      joint="forearm_pronation"
      ctrlrange="-90 90"
    />
  </actuator>
</mujoco>
