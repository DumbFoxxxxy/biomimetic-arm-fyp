Dim swApp As Object
Dim reportPath As String

Sub main()
    On Error Resume Next
    Set swApp = Application.SldWorks
    swApp.Visible = True

    Dim root As String
    root = "D:\XJTLU\PSP\tmp\audit_copy"
    Dim outDir As String
    outDir = root & "\audit"
    reportPath = outDir & "\report.txt"

    EnsureFolder outDir
    ResetFile reportPath

    Dim asmPath As String
    asmPath = FindFile(root, ".SLDASM")
    WriteLine reportPath, "assembly_path|" & asmPath
    If Len(asmPath) = 0 Then
        WriteLine reportPath, "ERROR|no_assembly_found"
        swApp.ExitApp
        Exit Sub
    End If

    Dim errs As Long
    Dim warns As Long
    Dim asm As Object
    Set asm = swApp.GetOpenDocumentByName(asmPath)
    If asm Is Nothing Then
        Set asm = swApp.OpenDoc6(asmPath, 2, 1, "", errs, warns)
    End If
    If asm Is Nothing Then
        WriteLine reportPath, "ERROR|could_not_open_assembly|" & errs & "|" & warns
        swApp.ExitApp
        Exit Sub
    End If

    On Error Resume Next
    WriteLine reportPath, "config|" & asm.ConfigurationManager.ActiveConfiguration.Name
    On Error GoTo 0

    Dim comps As Variant
    comps = asm.GetComponents(False)
    If IsEmpty(comps) Then
        WriteLine reportPath, "ERROR|no_components"
        swApp.ExitApp
        Exit Sub
    End If

    Dim i As Long
    Dim j As Long
    Dim c As Object
    Dim xf As Object
    Dim vals As Variant
    Dim line As String

    For i = LBound(comps) To UBound(comps)
        Set c = comps(i)
        line = "component|" & SafeStr(c.Name2) & "|" & SafeStr(c.GetPathName())
        line = line & "|suppressed=" & CStr(c.IsSuppressed())
        line = line & "|fixed=" & CStr(c.IsFixed())
        Set xf = Nothing
        vals = Empty
        On Error Resume Next
        Set xf = c.Transform2
        If Not xf Is Nothing Then
            vals = xf.ArrayData
        End If
        On Error GoTo 0
        If IsArray(vals) Then
            For j = LBound(vals) To UBound(vals)
                line = line & "|" & CStr(vals(j))
            Next j
        End If
        WriteLine reportPath, line

    Next i

    ' inspect every part in the folder, whether or not it is in the assembly
    Dim fso As Object
    Dim fl As Object
    Dim file As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set fl = fso.GetFolder(root)
    For Each file In fl.Files
        If UCase(Right(file.Name, 7)) = ".SLDPRT" Then
            InspectPart file.Path, outDir
        End If
    Next file

    ReportFrames asm, "assembly"
    WriteLine reportPath, "PASS|done"
    swApp.CloseDoc asm.GetTitle()
    swApp.ExitApp
End Sub

Sub InspectPart(path As String, outDir As String)
    Dim errs As Long
    Dim warns As Long
    Dim doc As Object
    Dim wasOpen As Boolean
    wasOpen = True
    Set doc = swApp.GetOpenDocumentByName(path)
    If doc Is Nothing Then
        wasOpen = False
        Set doc = swApp.OpenDoc6(path, 1, 1, "", errs, warns)
    End If
    If doc Is Nothing Then
        WriteLine reportPath, "part_error|" & path & "|" & errs & "|" & warns
        Exit Sub
    End If

    Dim base As String
    base = BaseName(path)
    Dim actErr As Long
    Dim box As Variant
    Dim line As String
    Dim k As Long
    Dim f As Object

    On Error Resume Next
    swApp.ActivateDoc3 doc.GetTitle(), False, 0, actErr
    On Error GoTo 0

    Dim bodies As Variant
    bodies = doc.GetBodies2(0, False)
    Dim nb As Long
    nb = CountArr(bodies)
    WriteLine reportPath, "part|" & base & "|" & path & "|solid_bodies=" & nb & _
        "|features=" & doc.GetFeatureCount()

    For k = LBound(bodies) To UBound(bodies)
        Dim body As Object
        Set body = bodies(k)
        Dim line2 As String
        line2 = "body|" & base & "|" & k
        On Error Resume Next
        box = body.GetBodyBox
        If IsArray(box) Then
            Dim m As Long
            For m = LBound(box) To UBound(box)
                line2 = line2 & "|" & CStr(box(m))
            Next m
        Else
            line2 = line2 & "|NOBOX"
        End If
        Dim mp As Variant
        Dim q As Long
        mp = body.GetMassProperties(1000#)
        If IsArray(mp) Then
            line2 = line2 & "|massprops="
            For q = LBound(mp) To UBound(mp)
                line2 = line2 & CStr(mp(q)) & ","
            Next q
        Else
            line2 = line2 & "|NOMASS"
        End If
        On Error GoTo 0
        WriteLine reportPath, line2
    Next k

    Set f = doc.FirstFeature()
    Do While Not f Is Nothing
        Dim tn As String
        tn = SafeStr(f.GetTypeName2())
        WriteLine reportPath, "feature|" & base & "|" & SafeStr(f.Name) & "|" & tn
        If tn = "RefPlane" Then
            Dim rp As Object
            Dim pxf As Object
            Dim pv As Variant
            Dim pline As String
            Set rp = Nothing
            Set pxf = Nothing
            pv = Empty
            On Error Resume Next
            Set rp = f.GetSpecificFeature2
            If Not rp Is Nothing Then
                Set pxf = rp.Transform
                If Not pxf Is Nothing Then
                    pv = pxf.ArrayData
                End If
            End If
            On Error GoTo 0
            pline = "plane|" & base & "|" & SafeStr(f.Name)
            If IsArray(pv) Then
                For k = LBound(pv) To UBound(pv)
                    pline = pline & "|" & CStr(pv(k))
                Next k
            Else
                pline = pline & "|NODATA"
            End If
            WriteLine reportPath, pline
        End If
        Set f = f.GetNextFeature()
    Loop

    ReportFrames doc, base

    Dim stlPath As String
    Dim ok As Boolean
    Dim e1 As Long
    Dim w1 As Long
    stlPath = outDir & "\" & base & ".stl"
    On Error Resume Next
    ok = doc.SaveAs3(stlPath, 0, 3)
    If Not ok Then
        ok = doc.Extension.SaveAs(stlPath, 0, 3, Nothing, e1, w1)
    End If
    On Error GoTo 0
    WriteLine reportPath, "stl|" & base & "|" & stlPath & "|" & CStr(ok)

    If Not wasOpen Then swApp.CloseDoc doc.GetTitle()
End Sub

Sub ReportFrames(doc As Object, label As String)
    Dim names As Variant
    Dim i As Long
    Dim j As Long
    Dim n As String
    Dim xf As Object
    Dim vals As Variant
    Dim line As String
    names = Array("SC_J", "AC_J", "GH_J", "ELBOW_J", "Origin")
    For i = LBound(names) To UBound(names)
        n = names(i)
        Set xf = Nothing
        vals = Empty
        On Error Resume Next
        Set xf = doc.Extension.GetCoordinateSystemTransformByName(n)
        If Not xf Is Nothing Then
            vals = xf.ArrayData
        End If
        On Error GoTo 0
        If xf Is Nothing Then
            WriteLine reportPath, "frame|" & label & "|" & n & "|MISSING"
        Else
            line = "frame|" & label & "|" & n
            If IsArray(vals) Then
                For j = LBound(vals) To UBound(vals)
                    line = line & "|" & CStr(vals(j))
                Next j
            End If
            WriteLine reportPath, line
        End If
    Next i
End Sub

Function FindFile(folder As String, ext As String) As String
    Dim fso As Object
    Dim fl As Object
    Dim file As Object
    Dim result As String
    result = ""
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set fl = fso.GetFolder(folder)
    For Each file In fl.Files
        If UCase(Right(file.Name, Len(ext))) = UCase(ext) Then
            result = file.Path
            Exit For
        End If
    Next file
    FindFile = result
End Function

Function BaseName(path As String) As String
    Dim p As String
    p = path
    Dim i As Long
    For i = Len(p) To 1 Step -1
        If Mid(p, i, 1) = "\" Then
            p = Mid(p, i + 1)
            Exit For
        End If
    Next i
    For i = Len(p) To 1 Step -1
        If Mid(p, i, 1) = "." Then
            p = Left(p, i - 1)
            Exit For
        End If
    Next i
    BaseName = p
End Function

Function SafeStr(v As Variant) As String
    On Error Resume Next
    If IsNull(v) Then
        SafeStr = ""
    Else
        SafeStr = CStr(v)
    End If
End Function

Function CountArr(a As Variant) As Long
    If IsEmpty(a) Then
        CountArr = 0
    Else
        CountArr = UBound(a) + 1
    End If
End Function

Sub EnsureFolder(path As String)
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    If Not fso.FolderExists(path) Then
        fso.CreateFolder path
    End If
End Sub

Sub ResetFile(path As String)
    Dim fso As Object
    Dim ts As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set ts = fso.CreateTextFile(path, True)
    ts.Close
End Sub

Sub WriteLine(path As String, msg As String)
    Dim fso As Object
    Dim ts As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set ts = fso.OpenTextFile(path, 8, True)
    ts.WriteLine msg
    ts.Close
End Sub
